<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.curfewsupervisor.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>-m</string>
    <string>daemon.main</string>
    <string>--config</string>
    <string>__PROJECT_ROOT__/config/supervisor.toml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/var/log/macos-curfew-supervisor/launchd-daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/macos-curfew-supervisor/launchd-daemon.err.log</string>
</dict>
</plist>
